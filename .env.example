# BusinessLabs AI Tech Consultant - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# ==============================================================================
# AI Provider Configuration
# Set to 'mock' for local development & offline evaluation without API keys.
# Set to 'anthropic' when an Anthropic Claude API key is available.
# ==============================================================================
PROVIDER_MODE=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=2048

# ==============================================================================
# Task 1: Knowledge Brain Settings
# ==============================================================================
KNOWLEDGE_BRAIN_HOST=127.0.0.1
KNOWLEDGE_BRAIN_PORT=8000
KNOWLEDGE_BRAIN_API_URL=http://127.0.0.1:8000
CRAWL_SITEMAP_URL=https://support.brilliantdirectories.com/support/sitemap.xml
CRAWL_DELAY_SECONDS=0.5
CRAWL_BATCH_SIZE=10
CRAWL_MAX_RETRIES=3
CHROMA_PERSIST_DIRECTORY=./data/chroma
SQLITE_DB_PATH=./data/knowledge_brain.db

# ==============================================================================
# Task 2: Inbox Agent Configuration
# ==============================================================================
AUTONOMOUS_SENDING_ENABLED=false
AUTONOMOUS_APPROVAL_STREAK=20
QUALITY_SIMILARITY_THRESHOLD=0.85

# ==============================================================================
# Task 3: Meeting-to-Scope Configuration
# ==============================================================================
DEFAULT_HOURLY_RATE=120
REQUIRE_HUMAN_SIGN_OFF=true
